{
  "name": "@tscodex/skey",
  "version": "0.3.0",
  "description": "Keep API tokens out of your AI assistant's context. Stored in the OS keychain, injected only into the process that needs them.",
  "type": "module",
  "bin": { "skey": "dist/cli.js" },
  "files": ["dist"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["secrets", "keychain", "credentials", "claude", "ai", "tokens"],
  "author": { "name": "unbywyd", "url": "https://unbywyd.com" },
  "homepage": "https://tscodex.com",
  "repository": { "type": "git", "url": "git+https://github.com/unbywyd/skey.git" },
  "bugs": { "url": "https://github.com/unbywyd/skey/issues" },
  "license": "MIT",
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
