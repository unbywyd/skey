    "cli",
    "tokens"
  ],
  "author": {
    "name": "unbywyd",
    "url": "https://unbywyd.com"
  },
  "homepage": "https://skey.tscodex.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unbywyd/skey.git"
  },
